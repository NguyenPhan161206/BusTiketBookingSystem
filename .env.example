# ===== App =====
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Chuỗi bí mật ký session cookie - BẮT BUỘC đổi khi triển khai
SESSION_SECRET=change-me-to-a-long-random-string
# true khi chạy sau HTTPS
COOKIE_SECURE=false
# Số phút session tồn tại
SESSION_MAX_AGE_MINUTES=120
# Chạy seed dữ liệu mẫu khi container khởi động (Docker)
SEED_ON_START=true

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bus_ticket
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Email (dev dùng Mailpit: http://localhost:8025) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bus Ticket <no-reply@busticket.local>"

# ===== Upload =====
UPLOAD_MAX_SIZE_MB=5

# ===== Rate limit (số request / 15 phút / IP) =====
RATE_LIMIT_MAX=1000

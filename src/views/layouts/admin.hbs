<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{csrfToken}}">
  <meta name="robots" content="noindex">
  <title>{{#if title}}{{title}} | {{/if}}Quản trị {{appName}}</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css">
  {{{_sections.head}}}
</head>
<body class="d-flex flex-column min-vh-100">
  {{!-- ============================================================
       LAYOUT QUẢN TRỊ / NHÂN VIÊN - khung trống do base dựng.
       TV2 phụ trách hoàn thiện topbar / sidebar / menu.
       Dùng trong controller: res.render('catalog/stations', { layout: 'admin', title: '...' })
       ============================================================ --}}
  <header class="navbar bg-dark border-bottom" data-bs-theme="dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/admin">Quản trị {{appName}}</a>
      {{!-- TODO(TV2): nút mở sidebar trên mobile, thông tin tài khoản --}}
    </div>
  </header>

  <div class="container-fluid flex-grow-1">
    <div class="row">
      <aside class="col-md-3 col-lg-2 border-end py-3 d-none d-md-block">
        {{!-- TODO(TV2): sidebar menu quản trị (dùng helper activeIf) --}}
      </aside>
      <main class="col-md-9 col-lg-10 py-4">
        {{> flash}}
        {{{body}}}
      </main>
    </div>
  </div>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  {{{_sections.scripts}}}
</body>
</html>

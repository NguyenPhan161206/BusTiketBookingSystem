<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="{{csrfToken}}">
  <title>{{#if title}}{{title}} | {{/if}}{{appName}}</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/app.css">
  {{{_sections.head}}}
</head>
<body class="d-flex flex-column min-vh-100">
  <header>
    <nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold text-primary" href="/">{{appName}}</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#customerNavbar"
          aria-controls="customerNavbar" aria-expanded="false" aria-label="Mở menu">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="customerNavbar">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><a class="nav-link" href="/">Trang chủ</a></li>
          </ul>
          <div class="d-flex flex-column flex-lg-row gap-2 py-2 py-lg-0">
            {{#if currentUser}}
              <a class="btn btn-outline-primary" href="/account/profile">Tài khoản</a>
              <form method="post" action="/auth/logout">
                <input type="hidden" name="_csrf" value="{{csrfToken}}">
                <button class="btn btn-primary w-100" type="submit">Đăng xuất</button>
              </form>
            {{else}}
              <a class="btn btn-outline-primary" href="/auth/login">Đăng nhập</a>
              <a class="btn btn-primary" href="/auth/register">Đăng ký</a>
            {{/if}}
          </div>
        </div>
      </div>
    </nav>
  </header>

  <main class="flex-grow-1 py-4">
    <div class="container">
      {{> flash}}
      {{{body}}}
    </div>
  </main>

  <footer class="border-top py-3 mt-auto">
    {{!-- TODO(TV3): footer khách hàng --}}
    <div class="container small text-body-secondary">&copy; {{year}} {{appName}}</div>
  </footer>

  <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  {{{_sections.scripts}}}
</body>
</html>

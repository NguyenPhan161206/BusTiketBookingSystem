<section class="home-hero rounded-4 overflow-hidden mb-5">
  <div class="row align-items-center g-0">
    <div class="col-lg-7 p-4 p-md-5">
      <span class="badge rounded-pill text-bg-light text-primary mb-3">Bus Ticket · Đặt vé dễ dàng</span>
      <h1 class="display-5 fw-bold text-white mb-3">Mỗi hành trình, một khởi đầu mới.</h1>
      <p class="lead text-white-50 mb-4">
        Bus Ticket đang hoàn thiện trải nghiệm đặt vé xe khách liên tỉnh. Tạo tài khoản để sẵn sàng
        quản lý thông tin và theo dõi hành trình của bạn.
      </p>
      <div class="d-flex flex-wrap gap-2">
        {{#if currentUser}}
          <a class="btn btn-light btn-lg text-primary fw-semibold" href="/account/profile">Tài khoản của tôi</a>
          <a class="btn btn-outline-light btn-lg" href="/account/bookings">Lịch sử đặt vé</a>
        {{else}}
          <a class="btn btn-light btn-lg text-primary fw-semibold" href="/auth/register">Tạo tài khoản</a>
          <a class="btn btn-outline-light btn-lg" href="/auth/login">Đăng nhập</a>
        {{/if}}
      </div>
    </div>
    <div class="col-lg-5 p-4 p-md-5 pt-lg-4">
      <div class="home-ticket-card rounded-4 bg-white p-4 shadow-lg">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
          <div>
            <div class="small text-body-secondary">HÀNH TRÌNH CỦA BẠN</div>
            <div class="fw-bold fs-5">Bắt đầu từ đây</div>
          </div>
          <span class="home-ticket-icon rounded-circle d-inline-flex align-items-center justify-content-center"
            aria-hidden="true">B</span>
        </div>
        <div class="d-flex gap-3 mb-3">
          <div class="home-route-mark d-flex flex-column align-items-center">
            <span class="home-route-dot"></span>
            <span class="home-route-line flex-grow-1"></span>
            <span class="home-route-dot home-route-dot-end"></span>
          </div>
          <div class="flex-grow-1">
            <div class="mb-3">
              <div class="small text-body-secondary">Điểm khởi hành</div>
              <div class="fw-semibold">Chọn nơi bạn muốn đi</div>
            </div>
            <div>
              <div class="small text-body-secondary">Điểm đến</div>
              <div class="fw-semibold">Khám phá điểm đến tiếp theo</div>
            </div>
          </div>
        </div>
        <div class="alert alert-primary small mb-0" role="note">
          Tính năng tìm chuyến và đặt vé sẽ được bổ sung trong các bước phát triển tiếp theo.
        </div>
      </div>
    </div>
  </div>
</section>

<section class="mb-5" aria-labelledby="home-features-title">
  <div class="text-center mb-4">
    <div class="small text-uppercase text-primary fw-semibold mb-2">Đồng hành cùng bạn</div>
    <h2 class="h3 fw-bold" id="home-features-title">Mọi thứ cần thiết cho tài khoản của bạn</h2>
    <p class="text-body-secondary mb-0">Một khởi đầu thuận tiện cho những chuyến đi sắp tới.</p>
  </div>
  <div class="row g-3">
    <div class="col-md-4">
      <article class="home-feature-card h-100 rounded-4 border bg-white p-4">
        <span class="home-feature-number d-inline-flex align-items-center justify-content-center rounded-3 mb-3">01</span>
        <h3 class="h5 fw-bold">Tạo tài khoản</h3>
        <p class="text-body-secondary mb-0">Đăng ký nhanh chóng để bắt đầu sử dụng các tính năng dành cho khách hàng.</p>
      </article>
    </div>
    <div class="col-md-4">
      <article class="home-feature-card h-100 rounded-4 border bg-white p-4">
        <span class="home-feature-number d-inline-flex align-items-center justify-content-center rounded-3 mb-3">02</span>
        <h3 class="h5 fw-bold">Bảo vệ tài khoản</h3>
        <p class="text-body-secondary mb-0">Xác thực email sau khi đăng ký để kích hoạt tài khoản của bạn.</p>
      </article>
    </div>
    <div class="col-md-4">
      <article class="home-feature-card h-100 rounded-4 border bg-white p-4">
        <span class="home-feature-number d-inline-flex align-items-center justify-content-center rounded-3 mb-3">03</span>
        <h3 class="h5 fw-bold">Quản lý thông tin</h3>
        <p class="text-body-secondary mb-0">Đăng nhập để cập nhật hồ sơ và xem lịch sử đặt vé khi tính năng được triển khai.</p>
      </article>
    </div>
  </div>
</section>

<section class="home-cta rounded-4 p-4 p-md-5 text-center">
  <h2 class="h3 fw-bold mb-2">Sẵn sàng cho hành trình tiếp theo?</h2>
  <p class="text-body-secondary mb-4">Đăng nhập nếu bạn đã có tài khoản, hoặc đăng ký để tham gia cùng Bus Ticket.</p>
  {{#if currentUser}}
    <a class="btn btn-primary px-4" href="/account/profile">Xem tài khoản</a>
  {{else}}
    <a class="btn btn-primary px-4 me-2 mb-2 mb-sm-0" href="/auth/register">Đăng ký miễn phí</a>
    <a class="btn btn-outline-primary px-4" href="/auth/login">Đăng nhập</a>
  {{/if}}
</section>

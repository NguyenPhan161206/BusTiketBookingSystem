<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex align-items-center mb-3">
      <a href="/admin/users" class="btn btn-outline-secondary btn-sm me-2">&larr; Quay lại</a>
      <h1 class="h4 fw-bold mb-0">Thêm người dùng mới</h1>
    </div>

    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <form method="post" action="/admin/users/create">
          <input type="hidden" name="_csrf" value="{{csrfToken}}">

          <div class="row g-3">
            <div class="col-md-6">
              <label for="fullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
              <input
                type="text"
                class="form-control"
                id="fullName"
                name="fullName"
                value="{{values.fullName}}"
                placeholder="Nguyễn Văn A"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="email" class="form-label">Email <span class="text-danger">*</span></label>
              <input
                type="email"
                class="form-control"
                id="email"
                name="email"
                value="{{values.email}}"
                placeholder="email@vidu.com"
                required
              >
            </div>

            <div class="col-md-6">
              <label for="phone" class="form-label">Số điện thoại</label>
              <input
                type="tel"
                class="form-control"
                id="phone"
                name="phone"
                value="{{values.phone}}"
                placeholder="0901234567"
              >
            </div>

            <div class="col-md-6">
              <label for="role" class="form-label">Vai trò <span class="text-danger">*</span></label>
              <select class="form-select" id="role" name="role" required>
                <option value="customer" {{#if (eq values.role "customer")}}selected{{/if}}>Khách hàng (customer)</option>
                <option value="staff" {{#if (eq values.role "staff")}}selected{{/if}}>Nhân viên soát vé (staff)</option>
                <option value="admin" {{#if (eq values.role "admin")}}selected{{/if}}>Quản trị viên (admin)</option>
              </select>
            </div>

            <div class="col-md-12">
              <label for="password" class="form-label">Mật khẩu khởi tạo <span class="text-danger">*</span></label>
              <input
                type="password"
                class="form-control"
                id="password"
                name="password"
                placeholder="Tối thiểu 6 ký tự"
                required
              >
              <div class="form-text">Tài khoản được tạo bởi quản trị viên sẽ tự động được đánh dấu đã xác thực email.</div>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
            <a href="/admin/users" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

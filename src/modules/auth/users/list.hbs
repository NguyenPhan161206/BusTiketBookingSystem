<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="h3 fw-bold mb-1">Quản lý người dùng</h1>
    <p class="text-secondary small mb-0">Danh sách tài khoản khách hàng, nhân viên và quản trị viên</p>
  </div>
  <a href="/admin/users/create" class="btn btn-primary">
    + Thêm người dùng
  </a>
</div>

<div class="card shadow-sm border-0 mb-4">
  <div class="card-body p-3">
    <form method="get" action="/admin/users" class="row g-2 align-items-center">
      <div class="col-md-5">
        <input
          type="text"
          class="form-control"
          name="search"
          placeholder="Tìm theo tên, email, số điện thoại..."
          value="{{filters.search}}"
        >
      </div>
      <div class="col-md-3">
        <select class="form-select" name="role">
          <option value="all">Tất cả vai trò</option>
          <option value="customer" {{#if (eq filters.role "customer")}}selected{{/if}}>Khách hàng (customer)</option>
          <option value="staff" {{#if (eq filters.role "staff")}}selected{{/if}}>Nhân viên (staff)</option>
          <option value="admin" {{#if (eq filters.role "admin")}}selected{{/if}}>Quản trị viên (admin)</option>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select" name="status">
          <option value="all">Tất cả trạng thái</option>
          <option value="active" {{#if (eq filters.status "active")}}selected{{/if}}>Hoạt động</option>
          <option value="inactive" {{#if (eq filters.status "inactive")}}selected{{/if}}>Đang khóa</option>
        </select>
      </div>
      <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary flex-grow-1">Lọc</button>
        <a href="/admin/users" class="btn btn-outline-secondary">Đặt lại</a>
      </div>
    </form>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Họ và tên</th>
          <th>Email</th>
          <th>Số điện thoại</th>
          <th>Vai trò</th>
          <th>Trạng thái</th>
          <th>Ngày tạo</th>
          <th class="text-end">Hành động</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}
          <tr>
            <td>#{{this.id}}</td>
            <td class="fw-semibold">{{this.full_name}}</td>
            <td>{{this.email}}</td>
            <td>{{#if this.phone}}{{this.phone}}{{else}}<span class="text-muted small">--</span>{{/if}}</td>
            <td>
              {{#if (eq this.role "admin")}}
                <span class="badge bg-danger">Admin</span>
              {{else if (eq this.role "staff")}}
                <span class="badge bg-primary">Staff</span>
              {{else}}
                <span class="badge bg-secondary">Customer</span>
              {{/if}}
            </td>
            <td>
              {{#if this.is_active}}
                <span class="badge bg-success">Hoạt động</span>
              {{else}}
                <span class="badge bg-danger">Bị khóa</span>
              {{/if}}
            </td>
            <td class="small text-secondary">{{formatDate this.created_at "datetime"}}</td>
            <td class="text-end">
              <div class="d-inline-flex gap-1">
                <a href="/admin/users/{{this.id}}" class="btn btn-sm btn-outline-secondary">
                  Chi tiết
                </a>
                <form method="post" action="/admin/users/{{this.id}}/toggle" class="d-inline">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}">
                  {{#if this.is_active}}
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Khóa tài khoản">
                      Khóa
                    </button>
                  {{else}}
                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản">
                      Mở
                    </button>
                  {{/if}}
                </form>
              </div>
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="8" class="text-center py-4 text-secondary">
              Không tìm thấy người dùng nào phù hợp với bộ lọc.
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{#if pagination}}
    <div class="card-footer bg-white py-3 border-top">
      {{> pagination pagination=pagination}}
    </div>
  {{/if}}
</div>

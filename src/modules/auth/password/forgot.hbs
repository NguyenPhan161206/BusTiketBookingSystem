<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <h2 class="h4 fw-bold mb-1">Quên mật khẩu?</h2>
          <p class="text-secondary small">Nhập địa chỉ email đăng ký để nhận liên kết đặt lại mật khẩu</p>
        </div>

        <form method="post" action="/auth/forgot-password" novalidate>
          <input type="hidden" name="_csrf" value="{{csrfToken}}">

          <div class="mb-4">
            <label for="email" class="form-label">Địa chỉ email</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="ten@vidu.com"
              value="{{values.email}}"
              required
              autofocus
            >
          </div>

          <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
            Gửi liên kết đặt lại
          </button>
        </form>

        <div class="text-center mt-4">
          <a href="/auth/login" class="text-decoration-none small text-secondary">
            &larr; Quay lại trang Đăng nhập
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

{
  "name": "bus-ticket-booking-system",
  "version": "0.1.0",
  "private": true,
  "description": "Bus Ticket Booking System - SSR web app (Node.js, Express, Handlebars, PostgreSQL)",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:docker": "knex migrate:latest && node scripts/seed-on-start.js && node src/server.js",
    "dev": "npm run build:css && nodemon src/server.js",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i src/styles/tailwind.css -o public/css/tailwind.css --watch",
    "migrate": "knex migrate:latest",
    "migrate:make": "node scripts/make-db-file.js migration",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "seed": "knex seed:run",
    "seed:make": "node scripts/make-db-file.js seed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@algolia/autocomplete-js": "^1.19.13",
    "@algolia/autocomplete-theme-classic": "^1.19.13",
    "bootstrap": "^5.3.9",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5"
  }
}
